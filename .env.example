# OpenRouter Configuration (Get a free key from https://openrouter.ai/)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Google Gemini Configuration (Optional alternative)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Set to "true" to force offline deterministic mode even if key is present
USE_MOCK_LLM=false
